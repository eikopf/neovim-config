;; sainnhe/everforest --- a muted, green-toned colorscheme

{:src :sainnhe/everforest
 :setup (fn []
          ;; variants --- soft, medium, hard
          (set vim.g.everforest_background :soft)
          (set vim.g.everforest_better_performance true)
          (set vim.g.everforest_show_eob false))}
